# Copy this file to ".env" and fill in your own EmailJS values.
# Get these from https://dashboard.emailjs.com after creating a free account.
# 1. Add an Email Service (e.g. connect your Gmail) -> copy its Service ID
# 2. Create an Email Template with variables: from_name, from_email, message -> copy its Template ID
# 3. Go to Account > General -> copy your Public Key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
